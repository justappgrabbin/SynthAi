%THE SAMPLE PROGRAM FROM SECTION 2.4 OF THE MESSY USER MANUAL (TR 272, 1976):
%"AN UPDATED VERSION OF A SMALL PIECE OF THE ORIGINAL MURDER MYSTERY PROGRAM".
%TRANSCRIBED FROM AN OCR OF THE SCANNED MANUAL. WHERE THE SCAN WAS UNREADABLE
%THE VALUE WAS RECONSTRUCTED FROM THE MANUAL'S OWN COMMENT ON THAT LINE; EACH
%SUCH LINE IS MARKED "RECON". ADDITIONS NEEDED TO MAKE THE SEGMENT RUN ON ITS
%OWN (THE MANUAL SAYS IT IS ONLY A PIECE) ARE MARKED "ADDED".
%
%NODE GRAMMAR NUMBER: 0 = PROPER NAME, 1 = COMMON NOUN, 2 = BARE WORD (THIS IMPLEMENTATION'S
%REALIZER CONVENTION; THE MANUAL USES 0 THROUGHOUT AND OMITS THE GRAMMAR).
%RELATION GRAMMAR NUMBERS ARE AS PRINTED: 2 ADJECTIVE, 3 VERB, 4 PREPOSITION.
%
$LIMITS START=19W3D10H, END=20W2D14H;
%
$NODES;
AFFAIR 1 = 'AFFAIR';
DETAILS 2 = 'DETAILS';
DRHUME 0 = 'DR. HUME' 'DR. BARTHOLOMEW HUME' 'HUME';
JAMES 0 = 'JAMES';
JOHNBUX 0 = 'JOHN' 'JOHN BUXLEY';
LADYBUX 0 = 'LADY BUXLEY';
LADYJANE 0 = 'JANE' 'LADY JANE';
LORDED 0 = 'LORD EDWARD' 'EDWARD';
LOVER 1 = 'LOVER';
MARION 0 = 'MARION';
MOVIE 1 = 'MOVIE';
MOVIG 0 = ;
PARK 1 = 'PARK';
PASSION 2 = 'PASSION';
TELEPHONE 1 = 'TELEPHONE';
TENNISCOURT 1 = 'TENNIS COURT';
THEY 2 = 'THEM';
%
$RELATIONS;
AFFECTION 3 0 = /'HATE'/-2.5/'DISLIKE'/-0.5/'LIKE'/2.5/'LOVE'/;
BLACKMAIL 3 0 = 'BLACKMAIL';
CARESS 3 0 = 'CARESS';
FLIRT 3 0 = 'FLIRT';
FLIRTWITH 3 0 = ;
FOLLOW 3 0 = 'FOLLOW';
GOSSIP 3 0 = 'GOSSIP';
GOZZIP 3 0 = ;
INVITE 3 0 = 'INVITE';
IS 3 0 = 'BE';
LEAVE 3 0 = 'LEAVE';
POS 5 0 = 'OF';
%RECON: THE NEXT FOUR LINES WERE PARTLY ILLEGIBLE IN THE SCAN
RUN 3 0 = 'RUN';
RUNINTO 3 0 = ;
SEE 3 0 = 'SEE';
SMILE 3 0 = 'SMILE';
TALK 3 0 = 'TALK';
TALKWITH 3 0 = ;
%
%ADJECTIVE RELATIONS
ATTRACTIVE 2 0 = /'UGLY'/-0.5/'PRETTY'/1.5/'BEAUTIFUL'/;
JEALOUS 2 0 = /'NOT JEALOUS'/0.5/'JEALOUS'/;
MARRIED 2 0 = 'MARRIED';
WEALTH 2 0 = /'IMPOVERISHED'/-2.5/'POOR'/0.5/'WELL TO DO'/2.5/'RICH'/;
%
%PREPOSITION RELATIONS
BY 4 0 = 'BY';
IN 4 0 = 'IN';
INTO 4 0 = 'INTO';
NEAR 4 0 = 'NEAR';
WITH 4 0 = 'WITH';
%
$CLASSES;
DETECT = DRHUME;
FEMALE = LADYBUX LADYJANE MARION;
LOSER = ;
MALE = DRHUME JOHNBUX JAMES LORDED;
PLASE = PARK MOVIE TENNISCOURT;
RENDM = ;
SPOUSE(JAMES) = MARION;
SPOUSE(LADYJANE) = LORDED;
SPOUSE(LORDED) = LADYJANE;
SPOUSE(MARION) = JAMES;
%
$NETWORK;
*LEXTRP (GOSSIP WITH) TO GOZZIP,
*LEXTRP (RUN INTO) TO RUNINTO,
*LEXTRP (TALK WITH) TO TALKWITH,
%ADDED: FLIRTWITH HAD NO LEXICAL ENTRY IN THE SEGMENT
*LEXTRP (FLIRT WITH) TO FLIRTWITH,
*SET (DRHUME WEALTH) = -2,
*SET (LADYJANE WEALTH) = 3,
*SET (LADYBUX ATTRACTIVE) = -2,
*SET (LORDED WEALTH) = 3,
*SET (LORDED AFFECTION LADYJANE) = 1,
*SET (LADYJANE AFFECTION LORDED) = 1,
*SET (LADYJANE ATTRACTIVE) = 1;
%ADDED: MARRIAGES (THE SPOUSE CLASS ALREADY STATES THEM) AND STARTING VALUES
(JAMES MARRIED), (MARION MARRIED), (LADYJANE MARRIED), (LORDED MARRIED),
*SET (MARION ATTRACTIVE) = 2, *SET (MARION WEALTH) = 1, *SET (JAMES WEALTH) = 0,
*SET (JOHNBUX WEALTH) = 1, *SET (LADYBUX WEALTH) = 2;
%ADDED: THE MANUAL SAYS RUNINTOG "IS ACTIVATED FROM A GROUP NOT SHOWN".
FOR 0M: *ENABLE RUNINTOG;
%
%TWO PERSONS HAVE AN AFFAIR. DEPENDING ON WHO SEES THEM, IT CAN GIVE RISE TO
%BLACKMAIL, GOSSIP, OR JEALOUSY.
$GROUP MOVIG: 10M/OFF;
$RULE: *DISABLE MOVIG;
$LOOP: X.PICK(RENDM);
$RULE: *REMOVE X FROM RENDM;
$LOOP: Y.PICK(RENDM);
$RULE: *ADD X TO RENDM;
$RULE: *SEC(X WITH Y)(Y IN PICK(PLASE)),
       (X NEAR Y),
       *SEC(Y CARESS X)(CARESS WITH PASSION),
       *SEC(Y IS LOVER)(LOVER POS X);
$LOOP L1: Z.PICK(FEMALE);
$SWITCH: T(L1);
  10,-10: (Z EQL RENDM);
$RULE: T(R1)
       *SEC(Z SEE AFFAIR)(Z FOLLOW THEY),
       (Z BLACKMAIL Y),
       *SET (Y WEALTH) =- 1,
       *SET (Z WEALTH) =+ 1;
  -10,0: (Z EQL DETECT) OR (Z EQL SPOUSE(RENDM));
  .8,-10: (Y MARRIED);
  -10,0,C: (Z BLACKMAIL Y);
%RECON: SCAN READS "25,722"; COMMENT SAYS "MUCH LIKELIER ... IF Z NEEDS THE MONEY"
  .25,-.2: VAL(Z WEALTH) LT 1;
$RULE: T(R1)
       (Z SEE AFFAIR),
       *SET (Z JEALOUS) =+ 2;
  10,-10: (Z EQL SPOUSE(RENDM));
$RULE: (Z SEE AFFAIR),
       *SEC(Z GOZZIP SPOUSE(X))(GOZZIP BY TELEPHONE)(GOZZIP WITH DETAILS);
  0,-10: (X MARRIED);
  -10,.8,C: (Z BLACKMAIL X);
$ENDLOOP;
$ENDLOOP;
$ENDLOOP;
$RULE R1: *ERASE RENDM;
$ENDGROUP;
%
%GUY MEETS A GIRL. THEY TALK, POSSIBLE AFFAIR.
$GROUP RUNINTOG: 1D/OFF;
$LOOP: M.MALE;
$SWITCH: T($NEXT M);
%RECON: SCAN READS "18,-10"; COMMENT: EITHER CONDITION SENDS US TO THE NEXT M
  10,0: (FEMALE FLIRTWITH M);
  10,0: VAL(M AFFECTION FEMALE) GT 2;
$LOOP: W.FEMALE;
$SWITCH: T($NEXT W);
  10,-10: (M EQL SPOUSE(W)) OR (M BLACKMAIL W) OR (W BLACKMAIL M);
%RECON: "45% CHANCE IF W IS REASONABLY ATTRACTIVE, OTHERWISE ONLY 5%"
$RULE: F($NEXT W)
       (W IN PICK(PLASE)),
       (M RUNINTO W),
       (M TALKWITH W),
       (W FLIRTWITH M);
  .4,0: VAL(W ATTRACTIVE) GT 0;
  :.05;
$RULE: T($ENDGROUP)
       (M INVITE W),
       *SET (M AFFECTION W) =+ 1,
       *SET (W AFFECTION M) =+ 1,
       *ENABLE MOVIG,
       *ADD SPOUSE(W) TO LOSER,
       *MOVE M TO RENDM,
       *ADD W TO RENDM;
  -10,10,C: VAL(W AFFECTION MALE) GT 2;
$RULE: ($ENDGROUP)
       *NEG(M RUNINTO W),
       (M SMILE), (M LEAVE W);
$ENDLOOP;
$ENDLOOP;
$ENDGROUP;
$END;
