diff --git a/computer/tests/native-resident-images.test.mjs b/computer/tests/native-resident-images.test.mjs
index 81e42da..79c7a40 100644
--- a/computer/tests/native-resident-images.test.mjs
+++ b/computer/tests/native-resident-images.test.mjs
@@ -169,3 +169,25 @@ test('MOBILE COMPUTER: resident_type echo and synthia58 delegate to the native r
   assert.equal(prime.launchUrl, 'http://127.0.0.1:17759');
   assert.deepEqual(calls.map(call => call.imageId), ['echo-image', 'prime-image']);
 });
+
+test('failed resident startup stops the launched process and publishes no active resident', async () => {
+  const runtime = await new NativeSeedRuntime({ persistence: new MemoryPersistence(), namespace: 'failed-image-loader' }).boot();
+  const stopped = [];
+  runtime.terminal = {
+    async hostApp(spec) { return { id: spec.id, status: 'active' }; },
+    async stopApp(id) { stopped.push(id); return { stopped: true }; },
+  };
+  const packageStore = { async verify() { return { installed: true, record: {
+    id: 'echo', residentType: 'echo', residentEntry: 'control.mjs', base: '/tmp/echo',
+    payloadSha256: 'c'.repeat(64), manifest: { name: 'Echo' },
+  } }; } };
+  let now = 0;
+  const loader = new NativeImageResidentLoader({ computer: runtime, packageStore,
+    clock: () => now,
+    fetchImpl: async (_url, options) => { assert.ok(options.signal); now = 100; throw new Error('connection refused'); },
+  });
+  await assert.rejects(loader.mount({ imageId: 'echo', timeoutMs: 1 }), /did not become healthy/);
+  assert.deepEqual(stopped, ['resident-echo-cccccccccccc']);
+  assert.equal(loader.snapshot().length, 0);
+  assert.equal(runtime.meshKernel.participant('echo'), null);
+});
