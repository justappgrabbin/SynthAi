FROM node:24-bookworm-slim
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/relay-browsers
COPY package.json package-lock.json ./
RUN npm ci --include=dev && npx playwright install --with-deps chromium
COPY computer ./computer
ENV NODE_ENV=production RELAY_DATA_DIR=/var/data/relay
CMD ["node", "computer/worker/server.mjs"]
