+++ b/test/32-admin-mode.test.mjs
@@ -0,0 +1,23 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { FederatedSynthia } from '../src/index.mjs';
+
+test('admin mode is session scoped, preserves identity state, and only overrides the birth-design execution gate', async () => {
+  const synthia = await FederatedSynthia.create();
+  await assert.rejects(() => synthia.chat('normal gate remains closed'), (error) => error.code === 'BIRTH_CONFIGURATION_REQUIRED');
+
+  const enabled = synthia.setAdminMode(true, { reason: 'developer-test' });
+  assert.equal(enabled.admin.enabled, true);
+  assert.equal(enabled.admin.scope, 'session');
+  assert.equal(enabled.admin.override, 'birth-design-execution-gate');
+  assert.equal(enabled.admin.identityPreserved, true);
+  assert.equal(enabled.identity.configured, false);
+
+  const chat = await synthia.chat('admin maintenance task');
+  assert.equal(chat.ok, true);
+  assert.equal(synthia.identityStatus().configured, false);
+
+  const disabled = synthia.setAdminMode(false);
+  assert.equal(disabled.admin.enabled, false);
+  await assert.rejects(() => synthia.chat('normal gate restored'), (error) => error.code === 'BIRTH_CONFIGURATION_REQUIRED');
+});
