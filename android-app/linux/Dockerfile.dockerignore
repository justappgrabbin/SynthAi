# Used only by android-app/linux/Dockerfile (Venom / SynthAI Computer rootfs).
# BuildKit picks up <Dockerfile>.dockerignore automatically.
# Keep the vendored Synthia 5.8 donor (hover face) out of the Venom image so
# Venom's rootfs stays exactly what it was before 5.8 was vendored.
computer/donors/synthia58

# Hover app has its own rootfs and is excluded from the Venom image.
computer/hover

.git
**/node_modules
**/__pycache__
**/.venv
**/.cache
**/dist
**/*.db
public
android-app/app/src/venom/assets
android-app/app/src/hover/assets
computer/donors/consciousness-realm
