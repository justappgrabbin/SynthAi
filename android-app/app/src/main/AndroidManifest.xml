        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar" />
</manifest>
